# Copy to backend/.env (or set in your shell). Never commit real values.

# PostgreSQL connection string (required).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/content_factory?sslmode=disable

# HTTP listen address. Keep it on localhost: multi-user authentication is not implemented yet.
HTTP_ADDR=127.0.0.1:8080

# Local Ollama server and model used for every AI feature.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional: a bigger model just for video scripts, e.g. qwen3:14b (about 9 GB of RAM).
# OLLAMA_SCRIPT_MODEL=qwen3:14b

# Upper bound for one model call. Local generation on small GPUs is slow.
LLM_TIMEOUT=10m

# Concurrent background jobs. Keep at 1 on a single small GPU.
WORKER_CONCURRENCY=1

# Identifier of the single local operator.
LOCAL_OWNER_ID=local

# Optional: serve the built web app (web/dist) from the Go server.
# WEB_DIST=../web/dist

# Integration tests only: a database the tests may create schemas in.
# TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/content_factory_test?sslmode=disable

# --- YouTube integration (optional; features stay off when unset) ---

# YouTube Data API key: measured niche demand/competition and handle checks.
YOUTUBE_API_KEY=

# Local daily quota budget in units (Google's default project quota is 10,000).
YOUTUBE_DAILY_QUOTA=10000

# --- Stock footage (optional) ---

# Pexels API key for the "Stock footage" video style (free: https://www.pexels.com/api/).
# Free tier: 200 requests per hour, 20,000 per month.
PEXELS_API_KEY=

# Google OAuth "Web application" client for connecting YouTube channels.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/api/oauth/youtube/callback

# Base64 32-byte key that encrypts stored OAuth tokens. Generate one with:
#   cd backend && go run ./cmd/keygen
# Changing it makes existing connections unreadable (reconnect them).
TOKEN_ENCRYPTION_KEY=

# Where the browser returns after Google authorization.
WEB_BASE_URL=http://127.0.0.1:5173
